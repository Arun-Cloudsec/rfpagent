# ─────────────────────────────────────────────────────────────
# RFP Agent — environment variables
# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" for local dev. On Railway, paste each
# KEY=value pair into the project's Variables tab — DO NOT commit
# real secrets to git.

# ── REQUIRED ─────────────────────────────────────────────────
# Session secret — used to sign auth cookies. Generate with:
#   openssl rand -hex 32
# If you don't set this, every redeploy logs out all users.
SESSION_SECRET=

# Anthropic API key — optional. If set, all users share this key.
# If unset, every user must paste their own key in Settings → Anthropic API Key.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Optional but recommended ─────────────────────────────────
# Default Claude model. Override per-request in code if needed.
# Current lineup: claude-opus-5, claude-sonnet-5, claude-haiku-4-5-20251001,
# claude-fable-5 (frontier tier). Sonnet 5 is the quality-per-second pick —
# close to Opus 4.8 in capability, but cheaper and faster than Sonnet 4.6.
CLAUDE_MODEL=claude-sonnet-5

# Model used for the Executive Brief and the on-demand deep dives.
# Leave blank to reuse CLAUDE_MODEL. The brief is a small, well-specified JSON
# job, so a faster model is a reasonable trade here if you want more speed.
# ── Model tiers for the Executive Brief ──────────────────────────────────
# The brief page offers three tiers. Any tier the API key cannot reach falls
# back to the balanced model automatically rather than failing the request.
#
#   ⚡ Fastest  → BRIEF_MODEL_FAST     mechanical extraction, lowest latency
#   ⭐ Balanced → BRIEF_MODEL          DEFAULT — best quality per second
#   🎯 Highest  → BRIEF_MODEL_QUALITY  hardest reasoning, slowest
BRIEF_MODEL=claude-sonnet-5
BRIEF_MODEL_FAST=claude-haiku-4-5-20251001
BRIEF_MODEL_QUALITY=claude-opus-5

# Where the JSON-file store lives. On Railway with the default
# ephemeral filesystem this resets on redeploy. To persist, mount
# a Railway Volume at /data and set: DATA_DIR=/data
DATA_DIR=./data

# How many days a login session lasts (default 30)
SESSION_DAYS=30

# Per-IP rate limits (requests per minute)
AI_RATE_PER_MIN=30
GENERAL_RATE_PER_MIN=240

# Hard cap on rows per JSON-file collection (memory safety)
STORAGE_CAP=500

# ── Optional integrations ────────────────────────────────────
# Leave blank to disable (the UI will show "not configured").

# Azure Cost Management (Service Principal credentials)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_SUBSCRIPTION_NAME=

# ElevenLabs Text-to-Speech (executive brief voice-over)
ELEVENLABS_API_KEY=

# Default ElevenLabs model. IMPORTANT: only eleven_turbo_v2_5 and
# eleven_flash_v2_5 accept a `language_code`; sending one to any other model
# makes the ElevenLabs API reject the request. The server drops the field
# automatically for models that don't support it.
#   eleven_multilingual_v2 — best quality, 29 languages, auto-detects language
#   eleven_flash_v2_5      — fastest, 32 languages, supports language locking
#   eleven_turbo_v2_5      — balanced, supports language locking
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Runtime ──────────────────────────────────────────────────
# Railway sets PORT automatically; only override locally.
PORT=3000
NODE_ENV=production


# ── Token & cost ledger ──────────────────────────────────────────────────
# The Tokens & Cost dashboard stores its ledger as JSON under DATA_DIR.
# Railway's filesystem is EPHEMERAL: the ledger resets on redeploy. Point
# DATA_DIR at a Railway volume for durable reporting, and use the dashboard's
# CSV export before a redeploy if you need to keep the history.
# STORAGE_CAP limits rows per collection so the ledger cannot fill the disk.
STORAGE_CAP=500

# ── ElevenLabs cost estimation ───────────────────────────────────────────
# TTS is billed per CHARACTER as credits against your monthly plan allowance,
# not per call. These are the published API rates (verified 2026-08-21) and are
# used to VALUE consumption on the dashboard — they are not an invoice figure.
# Adjust if your plan's effective rate differs.
#   Multilingual v2/v3 → $0.10 per 1,000 characters (1 credit/char)
#   Flash / Turbo v2.5 → $0.05 per 1,000 characters (0.5 credits/char)
TTS_RATE_MULTILINGUAL=0.10
TTS_RATE_FLASH=0.05
